---
// The homepage. Each <section> below is one band of the page — ask the AI to
// add, remove, or reorder them. Every `km` field / class="km" line is the Khmer
// caption shown under the English.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const steps = [
  {
    icon: '🎯',
    title: 'Choose a level and time',
    titleKm: 'ជ្រើសរើសកម្រិត និងពេលវេលា',
    text: 'Easy, Medium or Hard. Practice for 1, 2 or 5 minutes.',
    textKm: 'ងាយ មធ្យម ឬពិបាក។ ហាត់រយៈពេល ១, ២ ឬ ៥ នាទី។',
  },
  {
    icon: '⌨️',
    title: 'Type the text',
    titleKm: 'វាយអត្ថបទ',
    text: 'Correct letters turn green. Mistakes turn red, so you can see them right away.',
    textKm: 'អក្សរដែលត្រូវប្រែជាពណ៌បៃតង។ អក្សរដែលខុសប្រែជាពណ៌ក្រហម ដូច្នេះអ្នកអាចឃើញវាភ្លាមៗ។',
  },
  {
    icon: '📈',
    title: 'See your progress',
    titleKm: 'មើលការរីកចម្រើនរបស់អ្នក',
    text: 'Every session saves your speed and accuracy. Watch your numbers grow!',
    textKm: 'វគ្គនីមួយៗរក្សាទុកល្បឿន និងភាពត្រឹមត្រូវរបស់អ្នក។ មើលលេខរបស់អ្នកកើនឡើង!',
  },
];

const levels = [
  {
    name: 'Easy',
    nameKm: 'ងាយ',
    color: 'bg-leaf',
    text: 'Short, common English words. Great for your first sessions.',
    textKm: 'ពាក្យអង់គ្លេសខ្លីៗ ដែលប្រើញឹកញាប់។ ល្អសម្រាប់វគ្គដំបូងរបស់អ្នក។',
    example: 'cat run book happy water',
  },
  {
    name: 'Medium',
    nameKm: 'មធ្យម',
    color: 'bg-brand',
    text: 'Simple sentences about everyday life.',
    textKm: 'ប្រយោគសាមញ្ញអំពីជីវិតប្រចាំថ្ងៃ។',
    example: 'i go to school every morning',
  },
  {
    name: 'Hard',
    nameKm: 'ពិបាក',
    color: 'bg-ink',
    text: 'Real sentences with capital letters, numbers and punctuation.',
    textKm: 'ប្រយោគពិតៗ ដែលមានអក្សរធំ លេខ និងសញ្ញាវណ្ណយុត្តិ។',
    example: 'Phnom Penh has about 2 million people.',
  },
];

const tips = [
  {
    icon: '🪑',
    title: 'Sit up straight',
    titleKm: 'អង្គុយឱ្យត្រង់',
    text: 'Keep your feet on the floor and your wrists relaxed.',
    textKm: 'ដាក់ជើងលើឥដ្ឋ ហើយទុកកដៃឱ្យធូរស្រាល។',
  },
  {
    icon: '🖐️',
    title: 'Use the home row',
    titleKm: 'ប្រើជួរដើម (home row)',
    text: 'Put your left fingers on A S D F and your right fingers on J K L ;. Feel the bumps on F and J.',
    textKm: 'ដាក់ម្រាមដៃឆ្វេងលើ A S D F និងម្រាមដៃស្តាំលើ J K L ;។ ស្ទាបមើលស្នាមប៉ោងនៅលើ F និង J។',
  },
  {
    icon: '👀',
    title: "Don't look at the keys",
    titleKm: 'កុំមើលក្តារចុច',
    text: 'Look at the screen. It is slow at first, but you get much faster later.',
    textKm: 'មើលអេក្រង់។ ដំបូងវាយឺត ប៉ុន្តែក្រោយមកអ្នកនឹងលឿនជាងមុនច្រើន។',
  },
  {
    icon: '🎯',
    title: 'Accuracy first, speed later',
    titleKm: 'ភាពត្រឹមត្រូវមុន ល្បឿនក្រោយ',
    text: 'Try to make no mistakes. Speed comes naturally with practice.',
    textKm: 'ព្យាយាមកុំឱ្យខុស។ ល្បឿននឹងមកដោយធម្មជាតិ តាមរយៈការហាត់។',
  },
  {
    icon: '📅',
    title: 'Practice every day',
    titleKm: 'ហាត់រៀងរាល់ថ្ងៃ',
    text: 'Ten minutes every day is better than one hour once a week.',
    textKm: 'ដប់នាទីរៀងរាល់ថ្ងៃ ល្អជាងមួយម៉ោងម្តងក្នុងមួយសប្តាហ៍។',
  },
  {
    icon: '😊',
    title: 'Be kind to yourself',
    titleKm: 'កុំតឹងតែងនឹងខ្លួនឯង',
    text: 'Everyone makes mistakes. Just press Try again!',
    textKm: 'មនុស្សគ្រប់គ្នាតែងធ្វើខុស។ គ្រាន់តែចុច "សាកម្តងទៀត"!',
  },
];

// The fake typing box in the hero: green = typed correctly, red = mistake.
const demoDone = 'Practice makes ';
const demoWrong = 'p';
const demoRest = 'erfect.';
---

<Base>
  <Header />

  <main>
    <!-- HERO -->
    <section class="relative overflow-hidden">
      <div class="pointer-events-none absolute -top-40 -right-40 size-[36rem] rounded-full bg-sun/25 blur-3xl"></div>
      <div class="pointer-events-none absolute -bottom-40 -left-40 size-[30rem] rounded-full bg-brand/15 blur-3xl"></div>

      <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 sm:px-6 sm:py-24 lg:grid-cols-2">
        <div>
          <p class="inline-flex items-center gap-2 rounded-full border border-ink/10 bg-white/70 px-3 py-1 text-sm font-medium">
            <span class="size-2 rounded-full bg-leaf"></span>
            Free typing practice for students in Cambodia
          </p>
          <h1 class="mt-6 font-display text-5xl leading-[1.02] font-extrabold tracking-tight text-balance sm:text-6xl lg:text-7xl">
            Type English <span class="text-brand">faster</span>, one session at a time.
          </h1>
          <p lang="km" class="mt-4 text-xl text-ink/70">វាយអក្សរអង់គ្លេសកាន់តែលឿន ម្តងមួយវគ្គ។</p>
          <p class="mt-6 max-w-xl text-lg text-muted">
            Choose a level, type for a few minutes, and see your speed and accuracy. Your sessions are saved, so you can watch yourself improve.
            <span class="km" lang="km">ជ្រើសរើសកម្រិត វាយអក្សររយៈពេលពីរបីនាទី ហើយមើលល្បឿន និងភាពត្រឹមត្រូវរបស់អ្នក។ វគ្គរបស់អ្នកត្រូវបានរក្សាទុក ដូច្នេះអ្នកអាចមើលឃើញការរីកចម្រើនរបស់ខ្លួនឯង។</span>
          </p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href="/practice" class="rounded-full bg-brand px-6 py-3 font-semibold text-paper shadow-lg shadow-brand/25 transition hover:bg-brand-dark">
              Start a session → <span lang="km" class="font-khmer font-normal opacity-80">ចាប់ផ្តើមវគ្គ</span>
            </a>
            <a href="#how" class="rounded-full border border-ink/15 bg-white px-6 py-3 font-semibold transition hover:border-ink/40">
              How it works ↓ <span lang="km" class="font-khmer font-normal opacity-60">របៀបប្រើ</span>
            </a>
          </div>
        </div>

        <!-- Illustration: a typing session in progress -->
        <div class="relative" aria-hidden="true">
          <div class="rounded-2xl border border-ink/10 bg-white p-6 shadow-2xl">
            <div class="flex items-center justify-between text-sm font-semibold text-muted">
              <span>⏱ 0:42</span>
              <span class="rounded-full bg-paper px-3 py-1">Medium</span>
            </div>
            <p class="mt-6 font-mono text-2xl leading-relaxed sm:text-3xl">
              <span class="text-leaf">{demoDone}</span><span class="rounded bg-oops/15 text-oops underline">{demoWrong}</span><span class="text-ink/35">{demoRest}</span>
            </p>
            <div class="mt-6 grid grid-cols-2 gap-3">
              <div class="rounded-xl bg-paper p-4">
                <p class="font-display text-3xl font-extrabold text-brand">28</p>
                <p class="text-xs text-muted">words per minute</p>
              </div>
              <div class="rounded-xl bg-paper p-4">
                <p class="font-display text-3xl font-extrabold text-leaf">96%</p>
                <p class="text-xs text-muted">accuracy</p>
              </div>
            </div>
          </div>
          <div class="absolute -right-2 -bottom-6 rotate-[4deg] rounded-xl bg-sun px-4 py-2 font-display font-bold shadow-lg">
            New best! 🎉
          </div>
        </div>
      </div>
    </section>

    <!-- HOW IT WORKS -->
    <section id="how" class="scroll-mt-20 border-t border-ink/10 bg-white">
      <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
        <p class="font-semibold text-brand">How it works <span lang="km" class="font-khmer font-normal">· របៀបប្រើ</span></p>
        <h2 class="mt-2 max-w-2xl font-display text-4xl font-extrabold tracking-tight text-balance sm:text-5xl">
          Three steps. A few minutes a day.
        </h2>
        <p class="km mt-3 text-xl font-semibold sm:text-2xl" lang="km">បីជំហាន។ ពីរបីនាទីក្នុងមួយថ្ងៃ។</p>
        <ol class="mt-12 grid gap-4 md:grid-cols-3">
          {
            steps.map((s, i) => (
              <li class="rounded-2xl border border-ink/10 bg-paper p-6">
                <div class="flex items-center justify-between">
                  <span class="text-3xl">{s.icon}</span>
                  <span class="font-display text-sm font-bold text-ink/30">0{i + 1}</span>
                </div>
                <h3 class="mt-4 font-display text-xl font-bold">
                  {s.title}
                  <span class="km text-base" lang="km">{s.titleKm}</span>
                </h3>
                <p class="mt-2 text-muted">
                  {s.text}
                  <span class="km" lang="km">{s.textKm}</span>
                </p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- LEVELS -->
    <section id="levels" class="mx-auto max-w-6xl scroll-mt-20 px-4 py-20 sm:px-6 sm:py-28">
      <p class="font-semibold text-brand">Levels <span lang="km" class="font-khmer font-normal">· កម្រិត</span></p>
      <h2 class="mt-2 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">Start easy. Grow step by step.</h2>
      <p class="km mt-3 text-xl font-semibold sm:text-2xl" lang="km">ចាប់ផ្តើមពីងាយ។ រីកចម្រើនម្តងមួយជំហាន។</p>
      <div class="mt-12 grid gap-4 md:grid-cols-3">
        {
          levels.map((l) => (
            <a
              href={`/practice?level=${l.name.toLowerCase()}`}
              class="group flex flex-col rounded-2xl border border-ink/10 bg-white p-6 transition hover:-translate-y-1 hover:border-brand hover:shadow-xl"
            >
              <span class={`inline-block self-start rounded-full px-3 py-1 text-sm font-bold text-paper ${l.color}`}>
                {l.name} <span lang="km" class="font-khmer font-normal">· {l.nameKm}</span>
              </span>
              <span class="mt-4 flex-1 text-muted">
                {l.text}
                <span class="km" lang="km">{l.textKm}</span>
              </span>
              <span class="mt-4 rounded-lg bg-paper px-3 py-2 font-mono text-sm">{l.example}</span>
              <span class="mt-6 font-semibold text-brand">
                Practice {l.name} <span class="inline-block transition group-hover:translate-x-1">→</span>
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <!-- BIG STATEMENT -->
    <section class="bg-ink text-paper">
      <div class="mx-auto max-w-4xl px-4 py-20 text-center sm:px-6 sm:py-28">
        <p class="font-display text-3xl leading-tight font-bold text-balance sm:text-5xl">
          Typing well in English helps you <span class="text-sun">at school, at work, and online.</span>
        </p>
        <p lang="km" class="km mt-6 text-xl sm:text-2xl">
          ការវាយអក្សរអង់គ្លេសបានល្អ ជួយអ្នកនៅសាលារៀន នៅកន្លែងធ្វើការ និងនៅលើអ៊ីនធឺណិត។
        </p>
      </div>
    </section>

    <!-- TIPS -->
    <section id="tips" class="scroll-mt-20 bg-white">
      <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
        <p class="font-semibold text-brand">Tips <span lang="km" class="font-khmer font-normal">· គន្លឹះ</span></p>
        <h2 class="mt-2 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">Type like a pro</h2>
        <p class="km mt-3 text-xl font-semibold sm:text-2xl" lang="km">វាយអក្សរដូចអ្នកជំនាញ</p>
        <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            tips.map((t) => (
              <li class="rounded-2xl bg-paper p-6">
                <span class="text-3xl">{t.icon}</span>
                <h3 class="mt-3 font-display text-lg font-bold">
                  {t.title}
                  <span class="km text-base" lang="km">{t.titleKm}</span>
                </h3>
                <p class="mt-1 text-muted">
                  {t.text}
                  <span class="km" lang="km">{t.textKm}</span>
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- CALL TO ACTION -->
    <section class="px-4 py-20 sm:px-6">
      <div class="mx-auto max-w-6xl rounded-3xl bg-brand px-6 py-16 text-center text-paper sm:py-20">
        <h2 class="font-display text-4xl font-extrabold tracking-tight text-balance sm:text-5xl">Ready? Start your first session.</h2>
        <p class="km mt-3 text-xl font-semibold sm:text-2xl" lang="km">រួចរាល់ហើយឬនៅ? ចាប់ផ្តើមវគ្គដំបូងរបស់អ្នក។</p>
        <a href="/practice" class="mt-8 inline-block rounded-full bg-paper px-8 py-4 font-semibold text-ink transition hover:bg-sun">
          Start typing → <span lang="km" class="font-khmer font-normal">ចាប់ផ្តើមវាយ</span>
        </a>
      </div>
    </section>
  </main>

  <Footer />
</Base>
